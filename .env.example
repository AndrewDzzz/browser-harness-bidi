# Recommended one-shot local launcher:
#   bidi-firefox <<'PY'
#   print(page_info())
#   PY

# Direct BiDi websocket, for example Firefox remote debugging.
# BIDI_WS=ws://127.0.0.1:9222/session

# WebDriver server root URL, for example geckodriver or chromedriver.
# BIDI_WEBDRIVER_URL=http://127.0.0.1:9516
# BIDI_BROWSER_NAME=firefox
# BIDI_CAPABILITIES={"moz:firefoxOptions":{"args":["-headless"]}}


# Namespace daemon runtime files.
# BIDI_NAME=default
